model adex_2expnms_gap_rec_neuron:

    state:
        V_m mV = E_L      # Membrane potential
        w pA = 0 pA       # Adaptation current
        refr_t ms = 0 ms  # Refractory timer

    equations:
        # Bound V_m to prevent divergence of the exponential term near spike threshold
        inline V_bounded mV = min(V_m, V_peak)
        
        # Dual exponential kernels (difference of exponentials)
        kernel g_AMPA = (exp(-t / tau_decay_AMPA) - exp(-t / tau_rise_AMPA))
        kernel g_NMDA = (exp(-t / tau_decay_NMDA) - exp(-t / tau_rise_NMDA))
        kernel g_GABAA = (exp(-t / tau_decay_GABAA) - exp(-t / tau_rise_GABAA))
        kernel g_GABAB = (exp(-t / tau_decay_GABAB) - exp(-t / tau_rise_GABAB))
        
        # Add inlines to simplify the equation definition of V_m
        inline exp_arg real = (V_bounded - V_th) / Delta_T
        inline I_spike pA = g_L * Delta_T * exp(exp_arg)
        
        # Synaptic currents with normalization applied through impulse scaling
        recordable inline I_syn_AMPA pA = convolve(g_AMPA, AMPA_spikes) * norm_AMPA * (V_bounded - E_AMPA)
        recordable inline I_syn_NMDA pA = convolve(g_NMDA, NMDA_spikes) * norm_NMDA * (V_bounded - E_NMDA)
        recordable inline I_syn_GABAA pA = convolve(g_GABAA, GABAA_spikes) * norm_GABAA * (V_bounded - E_GABAA)
        recordable inline I_syn_GABAB pA = convolve(g_GABAB, GABAB_spikes) * norm_GABAB * (V_bounded - E_GABAB)
        
        V_m' = (- g_L * (V_bounded - E_L) - I_syn_AMPA - I_syn_NMDA - I_syn_GABAA - I_syn_GABAB + I_spike - w + I_e + I_gap) / C_m
        
        # Adaptation dynamics
        w' = (a_param * (V_bounded - E_L) - w) / tau_w
        
        # Refractory timer
        refr_t' = -1000 ms/s

    parameters:
        # Membrane and leak properties
        C_m pF = 1000 pF      # Membrane capacitance
        g_L nS = 50 nS        # Leak conductance
        E_L mV = -60 mV       # Resting potential
        
        # Spike threshold and reset
        V_th mV = -50 mV      # Threshold potential
        V_reset mV = -60 mV   # Reset potential
        Delta_T mV = 2.5 mV   # Slope factor
        V_peak mV = 0 mV      # Spike detection threshold
        
        # Refractory period
        t_ref ms = 2.5 ms     # Refractory period
        
        # Adaptation parameters
        tau_w ms = 600 ms     # Adaptation time constant
        a_param nS = 200 nS       # Subthreshold adaptation
        b_param pA = 20 pA        # Spike-triggered adaptation
        
        # Synaptic time constants
        tau_decay_AMPA ms = 5 ms      # AMPA decay time constant
        tau_rise_AMPA ms = 0.4 ms     # AMPA rise time constant
        tau_decay_NMDA ms = 150 ms    # NMDA decay time constant
        tau_rise_NMDA ms = 2 ms       # NMDA rise time constant
        tau_decay_GABAA ms = 20 ms    # GABAA decay time constant
        tau_rise_GABAA ms = 0.4 ms    # GABAA rise time constant
        tau_decay_GABAB ms = 200 ms   # GABAB decay time constant
        tau_rise_GABAB ms = 5 ms      # GABAB rise time constant
        
        # Synaptic reversal potentials
        E_AMPA mV = 0 mV          # AMPA reversal potential
        E_NMDA mV = 0 mV          # NMDA reversal potential
        E_GABAA mV = -80 mV       # GABAA reversal potential
        E_GABAB mV = -90 mV       # GABAB reversal potential
        
        # External input
        I_e pA = 0 pA         # Constant input current

    internals:
        # Time at which conductance peaks
        t_peak_AMPA ms = tau_decay_AMPA * tau_rise_AMPA * ln(tau_decay_AMPA / tau_rise_AMPA) / (tau_decay_AMPA - tau_rise_AMPA)
        t_peak_NMDA ms = tau_decay_NMDA * tau_rise_NMDA * ln(tau_decay_NMDA / tau_rise_NMDA) / (tau_decay_NMDA - tau_rise_NMDA)
        t_peak_GABAA ms = tau_decay_GABAA * tau_rise_GABAA * ln(tau_decay_GABAA / tau_rise_GABAA) / (tau_decay_GABAA - tau_rise_GABAA)
        t_peak_GABAB ms = tau_decay_GABAB * tau_rise_GABAB * ln(tau_decay_GABAB / tau_rise_GABAB) / (tau_decay_GABAB - tau_rise_GABAB)
        
        # Normalization constants to ensure peak of 1.0 nS for a spike of weight 1.0
        norm_AMPA nS = nS / (exp(-t_peak_AMPA / tau_decay_AMPA) - exp(-t_peak_AMPA / tau_rise_AMPA))
        norm_NMDA nS = nS / (exp(-t_peak_NMDA / tau_decay_NMDA) - exp(-t_peak_NMDA / tau_rise_NMDA))
        norm_GABAA nS = nS / (exp(-t_peak_GABAA / tau_decay_GABAA) - exp(-t_peak_GABAA / tau_rise_GABAA))
        norm_GABAB nS = nS / (exp(-t_peak_GABAB / tau_decay_GABAB) - exp(-t_peak_GABAB / tau_rise_GABAB))

    input:
        AMPA_spikes <- spike
        NMDA_spikes <- spike
        GABAA_spikes <- spike
        GABAB_spikes <- spike
	I_gap pA <- continuous

    output:
        spike

    update:
        if refr_t > 0 ms:
            # neuron is absolute refractory, do not evolve V_m
            integrate_odes(w, refr_t)
        else:
            # neuron not refractory
            integrate_odes(V_m, w)

    onCondition((refr_t <= 0 ms) and (V_m >= V_peak)):
        refr_t = t_ref
        V_m = V_reset
        w = w + b_param
        emit_spike()